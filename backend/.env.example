# ══════════════════════════════════════════════════════════════════════════════
# RUCHA backend — environment configuration template
# Copy this file to .env and fill in every value marked REQUIRED.
# NEVER commit your .env file. It is listed in .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ── Telegram sign-in ──────────────────────────────────────────────────────────
# REQUIRED for Telegram sign-in. Create a bot with @BotFather on Telegram.
# Use a bot created exclusively for RUCHA — never reuse a token.
# Leave blank to disable Telegram sign-in entirely.
TELEGRAM_BOT_TOKEN=

# Optional. Detected automatically from the token if left blank.
TELEGRAM_BOT_USERNAME=

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED. Use a strong, randomly generated password in production.
# Example: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional — change these if you need different user/db names.
POSTGRES_USER=rucha
POSTGRES_DB=rucha

# ── CORS ──────────────────────────────────────────────────────────────────────
# REQUIRED for production deployments.
# Set to your app's origin so only your client can call the API.
# Example: CORS_ORIGIN=https://rucha.app
# Multiple origins: CORS_ORIGIN=https://rucha.app,https://www.rucha.app
# WARNING: leaving this as * allows any website to call your API.
CORS_ORIGIN=*

# ── Server ────────────────────────────────────────────────────────────────────
# Optional. Defaults to 8081.
PORT=8081

# REQUIRED when running behind a reverse proxy (nginx, Caddy, Fly.io, etc.).
# Without this, rate limiting uses the proxy IP instead of the real client IP,
# which effectively disables rate limiting for all authentication endpoints.
TRUST_PROXY=true
