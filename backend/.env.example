# Copy to .env next to docker-compose.yml and fill in.

# Telegram sign-in: create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
# Optional. Found automatically from the token.
TELEGRAM_BOT_USERNAME=

# Google sign-in: Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web).
# Add your site address under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

POSTGRES_PASSWORD=change-me
CORS_ORIGIN=https://your-domain.example
